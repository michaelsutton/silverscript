pragma silverscript ^0.1.0;

contract ChessKing(
    byte[32] init_mux_hash,
    byte[352] init_route_hashes,
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status,
    int init_pending_from_x,
    int init_pending_from_y,
    int init_pending_to_x,
    int init_pending_to_y
) {
    byte[32] mux_hash = init_mux_hash;
    byte[352] route_hashes = init_route_hashes;
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;
    int turn = init_turn;
    int status = init_status;
    int pending_from_x = init_pending_from_x;
    int pending_from_y = init_pending_from_y;
    int pending_to_x = init_pending_to_x;
    int pending_to_y = init_pending_to_y;

    function abs_int(int value) : (int) {
        int result = value;
        if (value < 0) {
            result = 0 - value;
        }
        return(result);
    }

    entrypoint function apply(byte[] mux_prefix, byte[] mux_suffix) {
        require(status == 0);

        int from_x = pending_from_x;
        int from_y = pending_from_y;
        int to_x = pending_to_x;
        int to_y = pending_to_y;

        bool from_in_bounds = from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8;
        bool to_in_bounds = to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8;
        require(from_in_bounds && to_in_bounds);

        bool is_white_turn = turn == 0;
        bool is_black_turn = turn == 1;
        require(is_white_turn || is_black_turn);

        int from_idx = from_y * 8 + from_x;
        int to_idx = to_y * 8 + to_x;
        require(from_idx != to_idx);

        byte[64] prev_board = board;
        byte moving_piece = prev_board[from_idx];
        byte target_piece = prev_board[to_idx];
        int moving_num = OpBin2Num(moving_piece);
        int target_num = OpBin2Num(target_piece);
        require(moving_num == 6 || moving_num == 14);

        bool moving_is_white = moving_num == 6;
        bool moving_is_black = moving_num == 14;
        bool target_is_white = target_num >= 1 && target_num <= 6;
        bool target_is_black = target_num >= 9 && target_num <= 14;

        if (is_white_turn) {
            require(moving_is_white);
            require(!target_is_white);
        } else {
            require(moving_is_black);
            require(!target_is_black);
        }

        int dx = to_x - from_x;
        int dy = to_y - from_y;
        (int abs_dx) = abs_int(dx);
        (int abs_dy) = abs_int(dy);
        require(abs_dx <= 1 && abs_dy <= 1);

        int low_idx = from_idx;
        int high_idx = to_idx;
        byte first_slot = byte(0x00);
        byte second_slot = moving_piece;
        if (from_idx > to_idx) {
            low_idx = to_idx;
            high_idx = from_idx;
            first_slot = moving_piece;
            second_slot = byte(0x00);
        }

        byte[] prev_dyn = byte[](prev_board);
        byte[] prefix = prev_dyn.slice(0, low_idx);
        byte[] middle = prev_dyn.slice(low_idx + 1, high_idx);
        byte[] suffix = prev_dyn.slice(high_idx + 1, 64);
        byte[64] next_board = prefix + byte[1](first_slot) + middle + byte[1](second_slot) + suffix;

        State next_state = {
            mux_hash: mux_hash,
            route_hashes: route_hashes,
            white_player: white_player,
            black_player: black_player,
            board: next_board,
            turn: 1 - turn,
            status: status,
            pending_from_x: -1,
            pending_from_y: -1,
            pending_to_x: -1,
            pending_to_y: -1
        };
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        validateOutputStateWithTemplate(
            OpAuthOutputIdx(this.activeInputIndex, 0),
            next_state,
            mux_prefix,
            mux_suffix,
            mux_hash
        );
    }
}
