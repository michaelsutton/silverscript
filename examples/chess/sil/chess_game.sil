pragma silverscript ^0.1.0;

contract ChessGame(
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board
) {
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;

    // 0 = white turn, 1 = black turn
    int turn = 0;

    // 0 = ongoing, 1 = white wins, 2 = black wins
    int status = 0;

    #[covenant.singleton(mode = transition)]
    function play(
        byte[32] prev_white_player,
        byte[32] prev_black_player,
        byte[64] prev_board,
        int prev_turn,
        int prev_status,
        int from_x,
        int from_y,
        int to_x,
        int to_y,
        pubkey pk,
        sig s
    ) : (byte[32], byte[32], byte[64], int, int) {
        require(prev_status == 0);
        require(prev_board.length == 64);

        require(checkSig(s, pk));

        bool is_white_turn = prev_turn == 0;
        bool is_black_turn = prev_turn == 1;
        require(is_white_turn || is_black_turn);

        if (is_white_turn) {
            require(blake2b(pk) == prev_white_player);
        } else {
            require(blake2b(pk) == prev_black_player);
        }

        bool from_in_bounds = from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8;
        bool to_in_bounds = to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8;
        require(from_in_bounds && to_in_bounds);

        int from_idx = from_y * 8 + from_x;
        int to_idx = to_y * 8 + to_x;
        require(from_idx != to_idx);

        byte moving_piece = prev_board[from_idx];
        byte target_piece = prev_board[to_idx];
        require(moving_piece != 0x00);

        bool moving_is_white = moving_piece >= 0x01 && moving_piece <= 0x06;
        bool moving_is_black = moving_piece >= 0x09 && moving_piece <= 0x0e;
        require(moving_is_white || moving_is_black);

        bool target_is_white = target_piece >= 0x01 && target_piece <= 0x06;
        bool target_is_black = target_piece >= 0x09 && target_piece <= 0x0e;

        if (is_white_turn) {
            require(moving_is_white);
            require(!target_is_white);
        } else {
            require(moving_is_black);
            require(!target_is_black);
        }

        bool side_step_right = to_x == from_x + 1;
        bool side_step_left = to_x + 1 == from_x;
        bool side_step_two_right = to_x == from_x + 2;
        bool side_step_two_left = to_x + 2 == from_x;
        bool side_adjacent = side_step_right || side_step_left;

        bool up_one = to_y == from_y + 1;
        bool down_one = to_y + 1 == from_y;
        bool up_two = to_y == from_y + 2;
        bool down_two = to_y + 2 == from_y;

        int legal_move = 0;

        // Pawn: white=0x01, black=0x09
        bool is_pawn = moving_piece == 0x01 || moving_piece == 0x09;
        if (is_pawn) {
            if (moving_is_white) {
                bool one_step = to_x == from_x && up_one && target_piece == 0x00;
                bool two_step = false;
                if (from_y == 1 && to_x == from_x && up_two && target_piece == 0x00) {
                    int mid_idx = (from_y + 1) * 8 + from_x;
                    two_step = prev_board[mid_idx] == 0x00;
                }
                bool capture = side_adjacent && up_one && target_is_black;
                if (one_step || two_step || capture) {
                    legal_move = 1;
                }
            } else {
                bool one_step = to_x == from_x && down_one && target_piece == 0x00;
                bool two_step = false;
                if (from_y == 6 && to_x == from_x && down_two && target_piece == 0x00) {
                    int mid_idx = (from_y + -1) * 8 + from_x;
                    two_step = prev_board[mid_idx] == 0x00;
                }
                bool capture = side_adjacent && down_one && target_is_white;
                if (one_step || two_step || capture) {
                    legal_move = 1;
                }
            }
        }

        // Knight: white=0x02, black=0x0a
        bool is_knight = moving_piece == 0x02 || moving_piece == 0x0a;
        if (is_knight) {
            bool shape_1 = side_adjacent && (up_two || down_two);
            bool shape_2 = (side_step_two_right || side_step_two_left) && (up_one || down_one);
            if (shape_1 || shape_2) {
                legal_move = 1;
            }
        }

        // Bishop: white=0x03, black=0x0b
        bool is_bishop = moving_piece == 0x03 || moving_piece == 0x0b;
        if (is_bishop) {
            bool diag_a = to_x + from_y == to_y + from_x;
            bool diag_b = from_x + from_y == to_x + to_y;
            if ((diag_a || diag_b) && to_x != from_x && to_y != from_y) {
                legal_move = 1;
            }
        }

        // Rook: white=0x04, black=0x0c
        bool is_rook = moving_piece == 0x04 || moving_piece == 0x0c;
        if (is_rook) {
            bool straight = (to_x == from_x && to_y != from_y) || (to_y == from_y && to_x != from_x);
            if (straight) {
                legal_move = 1;
            }
        }

        // Queen: white=0x05, black=0x0d
        bool is_queen = moving_piece == 0x05 || moving_piece == 0x0d;
        if (is_queen) {
            bool diag_a = to_x + from_y == to_y + from_x;
            bool diag_b = from_x + from_y == to_x + to_y;
            bool diagonal = (diag_a || diag_b) && to_x != from_x && to_y != from_y;
            bool straight = (to_x == from_x && to_y != from_y) || (to_y == from_y && to_x != from_x);
            if (diagonal || straight) {
                legal_move = 1;
            }
        }

        // King: white=0x06, black=0x0e
        bool is_king = moving_piece == 0x06 || moving_piece == 0x0e;
        if (is_king) {
            bool same_x = to_x == from_x;
            bool same_y = to_y == from_y;
            bool near_x = same_x || side_adjacent;
            bool near_y = same_y || up_one || down_one;
            if (near_x && near_y && !(same_x && same_y)) {
                legal_move = 1;
            }
        }

        require(legal_move == 1);

        byte[] prev_board_dyn = byte[](prev_board);
        byte[] next_board_dyn = 0x;
        if (from_idx < to_idx) {
            byte[] prefix = prev_board_dyn.slice(0, from_idx);
            byte[] middle = prev_board_dyn.slice(from_idx + 1, to_idx);
            byte[] suffix = prev_board_dyn.slice(to_idx + 1, 64);
            next_board_dyn = prefix + byte[1](0x00) + middle + byte[1](moving_piece) + suffix;
        } else {
            byte[] prefix = prev_board_dyn.slice(0, to_idx);
            byte[] middle = prev_board_dyn.slice(to_idx + 1, from_idx);
            byte[] suffix = prev_board_dyn.slice(from_idx + 1, 64);
            next_board_dyn = prefix + byte[1](moving_piece) + middle + byte[1](0x00) + suffix;
        }
        byte[64] next_board = byte[64](next_board_dyn);

        int next_status = 0;
        if (is_white_turn && target_piece == 0x0e) {
            next_status = 1;
        }
        if (is_black_turn && target_piece == 0x06) {
            next_status = 2;
        }

        int next_turn = 0;
        if (next_status == 0) {
            if (is_white_turn) {
                next_turn = 1;
            } else {
                next_turn = 0;
            }
        } else {
            next_turn = prev_turn;
        }

        return(
            prev_white_player,
            prev_black_player,
            next_board,
            next_turn,
            next_status
        );
    }
}
