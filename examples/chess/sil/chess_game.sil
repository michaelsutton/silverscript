pragma silverscript ^0.1.0;

contract ChessGame(
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status
) {
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;

    // 0 = white turn, 1 = black turn
    int turn = init_turn;

    // 0 = ongoing, 1 = white wins, 2 = black wins
    int status = init_status;

    #[covenant.singleton(mode = transition)]
    function play(
        State prev_state,
        int from_x,
        int from_y,
        int to_x,
        int to_y,
        sig s,
        pubkey pk
    ) : (State) {
        require(prev_state.status == 0);
        require(prev_state.board.length == 64);

        bool is_white_turn = prev_state.turn == 0;
        bool is_black_turn = prev_state.turn == 1;
        require(is_white_turn || is_black_turn);

        if (is_white_turn) {
            require(blake2b(pk) == prev_state.white_player);
        } else {
            require(blake2b(pk) == prev_state.black_player);
        }
        require(checkSig(s, pk));

        bool from_in_bounds = from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8;
        bool to_in_bounds = to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8;
        require(from_in_bounds && to_in_bounds);

        int from_idx = from_y * 8 + from_x;
        int to_idx = to_y * 8 + to_x;
        require(from_idx != to_idx);

        byte moving_piece = prev_state.board[from_idx];
        byte target_piece = prev_state.board[to_idx];
        int moving_num = OpBin2Num(moving_piece);
        int target_num = OpBin2Num(target_piece);
        require(moving_num != 0);

        bool moving_is_white = moving_num >= 1 && moving_num <= 6;
        bool moving_is_black = moving_num >= 9 && moving_num <= 14;
        require(moving_is_white || moving_is_black);

        bool target_is_empty = target_num == 0;
        bool target_is_white = target_num >= 1 && target_num <= 6;
        bool target_is_black = target_num >= 9 && target_num <= 14;

        if (is_white_turn) {
            require(moving_is_white);
            require(!target_is_white);
        } else {
            require(moving_is_black);
            require(!target_is_black);
        }

        bool side_step_right = to_x == from_x + 1;
        bool side_step_left = to_x + 1 == from_x;
        bool side_step_two_right = to_x == from_x + 2;
        bool side_step_two_left = to_x + 2 == from_x;
        bool side_adjacent = side_step_right || side_step_left;

        bool up_one = to_y == from_y + 1;
        bool down_one = to_y + 1 == from_y;
        bool up_two = to_y == from_y + 2;
        bool down_two = to_y + 2 == from_y;

        int legal_move = 0;

        bool is_pawn = moving_num == 1 || moving_num == 9;
        if (is_pawn) {
            if (moving_is_white) {
                bool one_step = to_x == from_x && up_one && target_is_empty;
                bool two_step = false;
                if (from_y == 1 && to_x == from_x && up_two && target_is_empty) {
                    int mid_idx = (from_y + 1) * 8 + from_x;
                    two_step = OpBin2Num(prev_state.board[mid_idx]) == 0;
                }
                bool capture = side_adjacent && up_one && target_is_black;
                if (one_step || two_step || capture) {
                    legal_move = 1;
                }
            } else {
                bool one_step = to_x == from_x && down_one && target_is_empty;
                bool two_step = false;
                if (from_y == 6 && to_x == from_x && down_two && target_is_empty) {
                    int mid_idx = (from_y + -1) * 8 + from_x;
                    two_step = OpBin2Num(prev_state.board[mid_idx]) == 0;
                }
                bool capture = side_adjacent && down_one && target_is_white;
                if (one_step || two_step || capture) {
                    legal_move = 1;
                }
            }
        } else if (moving_num == 2 || moving_num == 10) {
            bool shape_1 = side_adjacent && (up_two || down_two);
            bool shape_2 = (side_step_two_right || side_step_two_left) && (up_one || down_one);
            if (shape_1 || shape_2) {
                legal_move = 1;
            }
        } else {
            // Keep first version simple: non-pawn/non-knight pieces can move freely for now.
            legal_move = 1;
        }

        require(legal_move == 1);

        int low_idx = from_idx;
        int high_idx = to_idx;
        byte first_slot = byte(0x00);
        byte second_slot = moving_piece;
        if (from_idx > to_idx) {
            low_idx = to_idx;
            high_idx = from_idx;
            first_slot = moving_piece;
            second_slot = byte(0x00);
        }

        byte[] prev_dyn = byte[](prev_state.board);
        byte[] prefix = prev_dyn.slice(0, low_idx);
        byte[] middle = prev_dyn.slice(low_idx + 1, high_idx);
        byte[] suffix = prev_dyn.slice(high_idx + 1, 64);
        byte[64] next_board = prefix + byte[1](first_slot) + middle + byte[1](second_slot) + suffix;

        int next_status = 0;
        int next_turn = 1 - prev_state.turn;

        return({
            white_player: prev_state.white_player,
            black_player: prev_state.black_player,
            board: next_board,
            turn: next_turn,
            status: next_status
        });
    }
}
