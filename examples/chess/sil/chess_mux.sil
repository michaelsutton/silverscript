pragma silverscript ^0.1.0;

contract ChessMux(
    byte[32] init_mux_hash,
    byte[32] init_pawn_hash,
    byte[32] init_knight_hash,
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status
) {
    byte[32] mux_hash = init_mux_hash;
    byte[32] pawn_hash = init_pawn_hash;
    byte[32] knight_hash = init_knight_hash;
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;
    int turn = init_turn;
    int status = init_status;

    function policy_route(State prev_state, int selector) : (byte[32]) {
        byte[32] prev_pawn_hash = prev_state.pawn_hash;
        byte[32] prev_knight_hash = prev_state.knight_hash;
        byte[32] target_hash = prev_pawn_hash;
        if (selector != 0) {
            require(selector == 1);
            target_hash = prev_knight_hash;
        }

        return(target_hash);
    }

    entrypoint function route(int selector, byte[] target_prefix, byte[] target_suffix) {
        int cov_out_count = OpAuthOutputCount(this.activeInputIndex);

        State prev_state = {
            mux_hash: mux_hash,
            pawn_hash: pawn_hash,
            knight_hash: knight_hash,
            white_player: white_player,
            black_player: black_player,
            board: board,
            turn: turn,
            status: status
        };
        (byte[32] target_hash) = policy_route(prev_state, selector);

        require(cov_out_count == 1);
        int cov_out_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        validateOutputStateWithTemplate(
            cov_out_idx,
            prev_state,
            target_prefix,
            target_suffix,
            target_hash
        );
    }
}
