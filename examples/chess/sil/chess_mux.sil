pragma silverscript ^0.1.0;

contract ChessMux(
    byte[32] init_mux_hash,
    byte[256] init_route_hashes,
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status,
    byte[4] init_castle_rights,
    int init_en_passant_idx,
    int init_pending_src_idx,
    int init_pending_dst_idx,
    int init_pending_promo,
    int init_recent_castle,
    int init_draw_state
) {
    // Shared chess state layout, reused verbatim by mux and every worker:
    // - status: 0 live, 1 white win, 2 black win, 3 draw
    // - castle_rights[0..3]: white K, white Q, black K, black Q
    // - en_passant_idx: -1 when absent
    // - pending_*: the move committed by mux for the selected worker
    // - recent_castle: 0 none, 1 wK, 2 wQ, 3 bK, 4 bQ
    // - draw_state: 0 normal, 1 draw claimed, 2 counterplay step
    byte[32] mux_hash = init_mux_hash;
    byte[256] route_hashes = init_route_hashes;
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;
    int turn = init_turn;
    int status = init_status;
    byte[4] castle_rights = init_castle_rights;
    int en_passant_idx = init_en_passant_idx;
    int pending_src_idx = init_pending_src_idx;
    int pending_dst_idx = init_pending_dst_idx;
    int pending_promo = init_pending_promo;
    int recent_castle = init_recent_castle;
    int draw_state = init_draw_state;

    entrypoint function route(
        int selector,
        int from_x,
        int from_y,
        int to_x,
        int to_y,
        int promo_piece,
        sig s,
        pubkey pk,
        byte[] target_prefix,
        byte[] target_suffix
    ) {
        // Only idle mux states may start a new move. Workers return here after
        // they have validated and applied exactly one committed move.
        require(status == 0);

        // Chess alternates between white (0) and black (1); no other turn value
        // is meaningful.
        bool is_white_turn = turn == 0;
        bool is_black_turn = turn == 1;
        require(is_white_turn || is_black_turn);

        // The side to move authorizes the route once here. Downstream workers
        // rely on the committed pending move and do not repeat signature checks.
        if (is_white_turn) {
            require(blake2b(pk) == white_player);
        } else {
            require(blake2b(pk) == black_player);
        }
        require(checkSig(s, pk));

        // The mux only commits moves whose endpoints are on the 8x8 board.
        bool from_in_bounds = from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8;
        bool to_in_bounds = to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8;
        require(from_in_bounds && to_in_bounds);

        // route_hashes layout by selector:
        // 0  -> pawn
        // 1  -> knight
        // 2  -> vert
        // 3  -> horiz
        // 4  -> diag
        // 5  -> king
        // 6  -> castle
        // 7  -> castle challenge prep
        // 8  -> mux (draw claim)
        // 9  -> mux (surrender)
        require(selector >= 0 && selector <= 9);
        // Draw negotiation reuses only ordinary move workers.
        require(draw_state == 0 || selector <= 5 || selector == 9);

        // Only pawn routes may carry a promotion choice.
        // Piece encoding:
        // white: 1 pawn, 2 knight, 3 bishop, 4 rook, 5 queen, 6 king
        // black: 9 pawn, 10 knight, 11 bishop, 12 rook, 13 queen, 14 king
        // black code = white code + 8
        //
        // Pawn promotion choices therefore use:
        // 2 knight, 3 bishop, 4 rook, 5 queen
        require(promo_piece == 0 || (selector == 0 && promo_piece >= 2 && promo_piece <= 5));

        int target_selector = selector;
        if (selector == 9) {
            target_selector = 8;
        }

        byte[] all_route_hashes = route_hashes + mux_hash;
        int hash_start = target_selector * 32;
        int hash_end = hash_start + 32;
        byte[32] target_hash = all_route_hashes.slice(hash_start, hash_end);

        int next_status = status;
        int next_turn = turn;
        int next_en_passant_idx = en_passant_idx;
        int next_pending_src_idx = from_y * 8 + from_x;
        int next_pending_dst_idx = to_y * 8 + to_x;
        int next_pending_promo = promo_piece;
        int next_recent_castle = 0;
        int next_draw_state = draw_state;

        bool is_draw_claim = selector == 8;
        bool is_surrender = selector == 9;
        if (is_draw_claim || is_surrender) {
            require(from_x == 0 && from_y == 0 && to_x == 0 && to_y == 0 && promo_piece == 0);

            next_en_passant_idx = -1;
            next_pending_src_idx = -1;
            next_pending_dst_idx = -1;
            next_pending_promo = 0;
            next_recent_castle = 0;

            if (is_draw_claim) {
                // Draw negotiation starts from the ordinary idle mux state. The
                // next ply belongs to the opponent, who now tries to find a
                // saving move for the claimant side.
                require(draw_state == 0);
                require(recent_castle == 0);

                next_turn = 1 - turn;
                next_draw_state = 1;
            } else {
                // Surrender is a mux-to-mux terminal transition. The side to move
                // concedes immediately and the game returns to mux with terminal status.
                if (turn == 0) {
                    next_status = 2;
                } else {
                    next_status = 1;
                }
                next_draw_state = 0;
            }
        } else {
            // Mux is the only writer of pending move fields. A normal opponent
            // reply implicitly accepts any recent castle by clearing recent_castle;
            // selector 7 preserves it and enters the explicit challenge path.
            if (selector == 7) {
                require(recent_castle != 0);
                next_recent_castle = recent_castle;
            }
        }

        State next_state = {
            mux_hash: mux_hash,
            route_hashes: route_hashes,
            white_player: white_player,
            black_player: black_player,
            board: board,
            turn: next_turn,
            status: next_status,
            castle_rights: castle_rights,
            en_passant_idx: next_en_passant_idx,
            pending_src_idx: next_pending_src_idx,
            pending_dst_idx: next_pending_dst_idx,
            pending_promo: next_pending_promo,
            recent_castle: next_recent_castle,
            draw_state: next_draw_state
        };
        // Mux must produce exactly one authorized output with the selected template.
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        validateOutputStateWithTemplate(
            OpAuthOutputIdx(this.activeInputIndex, 0),
            next_state,
            target_prefix,
            target_suffix,
            target_hash
        );
    }

    entrypoint function timeout(sig s, pubkey pk, byte[] target_prefix, byte[] target_suffix) {
        // Timeout only applies while the game is still live.
        require(status == 0);

        bool is_white_turn = turn == 0;
        bool is_black_turn = turn == 1;
        require(is_white_turn || is_black_turn);

        // The side waiting on a response is `turn`, so the timeout claimant is
        // always the opposite signer.
        if (is_white_turn) {
            require(blake2b(pk) == black_player);
        } else {
            require(blake2b(pk) == white_player);
        }
        require(checkSig(s, pk));

        // Timeout proofs use DAA-zone locktime plus a non-final input sequence.
        // If this spend is accepted, consensus implies current_daa > tx.locktime.
        require(tx.locktime < 500000000000);
        require(OpTxInputSeq(this.activeInputIndex) != 0xffffffffffffffff);
        int timeout_delta_daa = 600;
        int min_locktime = OpTxInputDaaScore(this.activeInputIndex) + timeout_delta_daa - 1;
        require(tx.locktime >= min_locktime);

        // Ordinary timeout loses for the side that owed the next signed route.
        // Draw-state 1 is the one exception: silence accepts the draw claim.
        int next_status = 1;
        if (turn == 0) {
            next_status = 2;
        }
        if (draw_state == 1) {
            next_status = 3;
        }

        State next_state = {
            mux_hash: mux_hash,
            route_hashes: route_hashes,
            white_player: white_player,
            black_player: black_player,
            board: board,
            turn: turn,
            status: next_status,
            castle_rights: castle_rights,
            en_passant_idx: en_passant_idx,
            pending_src_idx: pending_src_idx,
            pending_dst_idx: pending_dst_idx,
            pending_promo: pending_promo,
            recent_castle: recent_castle,
            draw_state: draw_state
        };
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        validateOutputStateWithTemplate(
            OpAuthOutputIdx(this.activeInputIndex, 0),
            next_state,
            target_prefix,
            target_suffix,
            mux_hash
        );
    }

}
