pragma silverscript ^0.1.0;

contract ChessStraight(
    byte[32] init_mux_hash,
    byte[32] init_pawn_hash,
    byte[32] init_knight_hash,
    byte[32] init_straight_hash,
    byte[32] init_diagonal_hash,
    byte[32] init_king_hash,
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status
) {
    byte[32] mux_hash = init_mux_hash;
    byte[32] pawn_hash = init_pawn_hash;
    byte[32] knight_hash = init_knight_hash;
    byte[32] straight_hash = init_straight_hash;
    byte[32] diagonal_hash = init_diagonal_hash;
    byte[32] king_hash = init_king_hash;
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;
    int turn = init_turn;
    int status = init_status;

    function abs_int(int value) : (int) {
        int result = value;
        if (value < 0) {
            result = 0 - value;
        }
        return(result);
    }

    function policy_apply(
        State prev_state,
        int from_x,
        int from_y,
        int to_x,
        int to_y,
        sig s,
        pubkey pk
    ) : (State) {
        require(prev_state.status == 0);

        bool is_white_turn = prev_state.turn == 0;
        bool is_black_turn = prev_state.turn == 1;
        require(is_white_turn || is_black_turn);

        if (is_white_turn) {
            require(blake2b(pk) == prev_state.white_player);
        } else {
            require(blake2b(pk) == prev_state.black_player);
        }
        require(checkSig(s, pk));

        bool from_in_bounds = from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8;
        bool to_in_bounds = to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8;
        require(from_in_bounds && to_in_bounds);

        int from_idx = from_y * 8 + from_x;
        int to_idx = to_y * 8 + to_x;
        require(from_idx != to_idx);

        byte[64] prev_board = prev_state.board;
        byte moving_piece = prev_board[from_idx];
        byte target_piece = prev_board[to_idx];
        int moving_num = OpBin2Num(moving_piece);
        int target_num = OpBin2Num(target_piece);
        require(moving_num == 4 || moving_num == 12 || moving_num == 5 || moving_num == 13);

        bool moving_is_white = moving_num >= 1 && moving_num <= 6;
        bool moving_is_black = moving_num >= 9 && moving_num <= 14;
        bool target_is_white = target_num >= 1 && target_num <= 6;
        bool target_is_black = target_num >= 9 && target_num <= 14;

        if (is_white_turn) {
            require(moving_is_white);
            require(!target_is_white);
        } else {
            require(moving_is_black);
            require(!target_is_black);
        }

        int dx = to_x - from_x;
        int dy = to_y - from_y;
        (int abs_dx) = abs_int(dx);
        (int abs_dy) = abs_int(dy);

        bool same_file = from_x == to_x && abs_dy > 0;
        bool same_rank = from_y == to_y && abs_dx > 0;
        require(same_file || same_rank);

        int clear = 1;
        if (same_file) {
            for (i, 0, 7, 7) {
                bool before_target = i < abs_dy + -1;
                if (before_target) {
                    int scan_y = from_y + i + 1;
                    if (to_y < from_y) {
                        scan_y = from_y - i - 1;
                    }
                    int idx = scan_y * 8 + from_x;
                    if (OpBin2Num(prev_board[idx]) != 0) {
                        clear = 0;
                    }
                }
            }
        } else {
            for (i, 0, 7, 7) {
                bool before_target = i < abs_dx + -1;
                if (before_target) {
                    int scan_x = from_x + i + 1;
                    if (to_x < from_x) {
                        scan_x = from_x - i - 1;
                    }
                    int idx = from_y * 8 + scan_x;
                    if (OpBin2Num(prev_board[idx]) != 0) {
                        clear = 0;
                    }
                }
            }
        }

        require(clear == 1);

        int low_idx = from_idx;
        int high_idx = to_idx;
        byte first_slot = byte(0x00);
        byte second_slot = moving_piece;
        if (from_idx > to_idx) {
            low_idx = to_idx;
            high_idx = from_idx;
            first_slot = moving_piece;
            second_slot = byte(0x00);
        }

        byte[] prev_dyn = byte[](prev_board);
        byte[] prefix = prev_dyn.slice(0, low_idx);
        byte[] middle = prev_dyn.slice(low_idx + 1, high_idx);
        byte[] suffix = prev_dyn.slice(high_idx + 1, 64);
        byte[64] next_board = prefix + byte[1](first_slot) + middle + byte[1](second_slot) + suffix;

        return({
            mux_hash: prev_state.mux_hash,
            pawn_hash: prev_state.pawn_hash,
            knight_hash: prev_state.knight_hash,
            straight_hash: prev_state.straight_hash,
            diagonal_hash: prev_state.diagonal_hash,
            king_hash: prev_state.king_hash,
            white_player: prev_state.white_player,
            black_player: prev_state.black_player,
            board: next_board,
            turn: 1 - prev_state.turn,
            status: prev_state.status
        });
    }

    entrypoint function apply(
        int from_x,
        int from_y,
        int to_x,
        int to_y,
        sig s,
        pubkey pk,
        byte[] mux_prefix,
        byte[] mux_suffix
    ) {
        int cov_out_count = OpAuthOutputCount(this.activeInputIndex);

        State prev_state = {
            mux_hash: mux_hash,
            pawn_hash: pawn_hash,
            knight_hash: knight_hash,
            straight_hash: straight_hash,
            diagonal_hash: diagonal_hash,
            king_hash: king_hash,
            white_player: white_player,
            black_player: black_player,
            board: board,
            turn: turn,
            status: status
        };
        (State cov_new_state) = policy_apply(prev_state, from_x, from_y, to_x, to_y, s, pk);

        require(cov_out_count == 1);
        int cov_out_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        validateOutputStateWithTemplate(
            cov_out_idx,
            cov_new_state,
            mux_prefix,
            mux_suffix,
            mux_hash
        );
    }
}
