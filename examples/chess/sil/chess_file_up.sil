pragma silverscript ^0.1.0;

contract ChessFileUp(
    byte[32] init_mux_hash,
    byte[32] init_pawn_hash,
    byte[32] init_knight_hash,
    byte[32] init_file_up_hash,
    byte[32] init_file_down_hash,
    byte[32] init_rank_left_hash,
    byte[32] init_rank_right_hash,
    byte[32] init_diag_up_right_hash,
    byte[32] init_diag_up_left_hash,
    byte[32] init_diag_down_right_hash,
    byte[32] init_diag_down_left_hash,
    byte[32] init_king_hash,
    byte[32] init_white_player,
    byte[32] init_black_player,
    byte[64] init_board,
    int init_turn,
    int init_status,
    int init_pending_from_x,
    int init_pending_from_y,
    int init_pending_to_x,
    int init_pending_to_y
) {
    byte[32] mux_hash = init_mux_hash;
    byte[32] pawn_hash = init_pawn_hash;
    byte[32] knight_hash = init_knight_hash;
    byte[32] file_up_hash = init_file_up_hash;
    byte[32] file_down_hash = init_file_down_hash;
    byte[32] rank_left_hash = init_rank_left_hash;
    byte[32] rank_right_hash = init_rank_right_hash;
    byte[32] diag_up_right_hash = init_diag_up_right_hash;
    byte[32] diag_up_left_hash = init_diag_up_left_hash;
    byte[32] diag_down_right_hash = init_diag_down_right_hash;
    byte[32] diag_down_left_hash = init_diag_down_left_hash;
    byte[32] king_hash = init_king_hash;
    byte[32] white_player = init_white_player;
    byte[32] black_player = init_black_player;
    byte[64] board = init_board;
    int turn = init_turn;
    int status = init_status;
    int pending_from_x = init_pending_from_x;
    int pending_from_y = init_pending_from_y;
    int pending_to_x = init_pending_to_x;
    int pending_to_y = init_pending_to_y;

    entrypoint function apply(byte[] mux_prefix, byte[] mux_suffix) {
        int cov_out_count = OpAuthOutputCount(this.activeInputIndex);
        require(status == 0);

        int from_x = pending_from_x;
        int from_y = pending_from_y;
        int to_x = pending_to_x;
        int to_y = pending_to_y;

        require(from_x >= 0 && from_x < 8 && from_y >= 0 && from_y < 8);
        require(to_x >= 0 && to_x < 8 && to_y >= 0 && to_y < 8);
        require(turn == 0 || turn == 1);

        int from_idx = from_y * 8 + from_x;
        int to_idx = to_y * 8 + to_x;
        require(from_idx != to_idx);

        byte[64] prev_board = board;
        byte moving_piece = prev_board[from_idx];
        byte target_piece = prev_board[to_idx];
        int moving_num = OpBin2Num(moving_piece);
        int target_num = OpBin2Num(target_piece);
        require(moving_num == 4 || moving_num == 5 || moving_num == 12 || moving_num == 13);

        bool target_is_white = target_num >= 1 && target_num <= 6;
        bool target_is_black = target_num >= 9 && target_num <= 14;
        if (turn == 0) {
            require(moving_num == 4 || moving_num == 5);
            require(!target_is_white);
        } else {
            require(moving_num == 12 || moving_num == 13);
            require(!target_is_black);
        }

        require(to_x == from_x && to_y > from_y);

        int distance = to_y - from_y;
        int clear = 1;
        for (i, 0, 7, 7) {
            if (i < distance + -1) {
                int scan_x = from_x;
                int scan_y = from_y + i + 1;
                int scan_idx = scan_y * 8 + scan_x;
                if (OpBin2Num(prev_board[scan_idx]) != 0) {
                    clear = 0;
                }
            }
        }
        require(clear == 1);

        int low_idx = from_idx;
        int high_idx = to_idx;
        byte first_slot = byte(0x00);
        byte second_slot = moving_piece;
        if (from_idx > to_idx) {
            low_idx = to_idx;
            high_idx = from_idx;
            first_slot = moving_piece;
            second_slot = byte(0x00);
        }

        byte[] prev_dyn = byte[](prev_board);
        byte[] prefix = prev_dyn.slice(0, low_idx);
        byte[] middle = prev_dyn.slice(low_idx + 1, high_idx);
        byte[] suffix = prev_dyn.slice(high_idx + 1, 64);
        byte[64] next_board = prefix + byte[1](first_slot) + middle + byte[1](second_slot) + suffix;

        State next_state = {
            mux_hash: mux_hash,
            pawn_hash: pawn_hash,
            knight_hash: knight_hash,
            file_up_hash: file_up_hash,
            file_down_hash: file_down_hash,
            rank_left_hash: rank_left_hash,
            rank_right_hash: rank_right_hash,
            diag_up_right_hash: diag_up_right_hash,
            diag_up_left_hash: diag_up_left_hash,
            diag_down_right_hash: diag_down_right_hash,
            diag_down_left_hash: diag_down_left_hash,
            king_hash: king_hash,
            white_player: white_player,
            black_player: black_player,
            board: next_board,
            turn: 1 - turn,
            status: status,
            pending_from_x: -1,
            pending_from_y: -1,
            pending_to_x: -1,
            pending_to_y: -1
        };

        require(cov_out_count == 1);
        int cov_out_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        validateOutputStateWithTemplate(cov_out_idx, next_state, mux_prefix, mux_suffix, mux_hash);
    }
}
