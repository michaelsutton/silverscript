contract A(byte[32] initMuxHash, byte[32] initAHash, byte[32] initBHash, int initValue) {
    byte[32] muxHash = initMuxHash;
    byte[32] aHash = initAHash;
    byte[32] bHash = initBHash;
    int value = initValue;

    // Worker A updates its own worker hash and increments value by a caller-chosen reward.
    entrypoint function apply(int reward, byte[32] nextAHash, byte[] muxPrefix, byte[] muxSuffix) {
        require(reward > 0);
        require(reward < 10);

        validateOutputStateWithTemplate(
            0,
            {muxHash: muxHash, aHash: nextAHash, bHash: bHash, value: value + reward},
            muxPrefix,
            muxSuffix,
            muxHash
        );
    }
}
