contract Mux(byte[32] initMuxHash, byte[32] initAHash, byte[32] initBHash, int initValue) {
    byte[32] muxHash = initMuxHash;
    byte[32] aHash = initAHash;
    byte[32] bHash = initBHash;
    int value = initValue;

    // The caller selects which worker path to route to.
    entrypoint function route(int selector, byte[] targetPrefix, byte[] targetSuffix) {
        byte[32] targetHash = aHash;
        if (selector != 0) {
            require(selector == 1);
            targetHash = bHash;
        }

        validateOutputStateWithTemplate(
            0,
            {muxHash: muxHash, aHash: aHash, bHash: bHash, value: value},
            targetPrefix,
            targetSuffix,
            targetHash
        );
    }
}
