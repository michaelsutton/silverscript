contract B(byte[32] initMuxHash, byte[32] initAHash, byte[32] initBHash, int initValue) {
    byte[32] muxHash = initMuxHash;
    byte[32] aHash = initAHash;
    byte[32] bHash = initBHash;
    int value = initValue;

    // Worker B updates its own worker hash and applies a net value change from two args.
    entrypoint function apply(int gain, int fee, byte[32] nextBHash, byte[] muxPrefix, byte[] muxSuffix) {
        require(gain > fee);

        validateOutputStateWithTemplate(
            0,
            {muxHash: muxHash, aHash: aHash, bHash: nextBHash, value: value + gain - fee},
            muxPrefix,
            muxSuffix,
            muxHash
        );
    }
}
