contract B(byte[32] init_mux_template, byte[32] init_a_template, byte[32] init_b_template, int init_value) {
    // Injected immutable peer templates (see mux.sil)
    byte[32] mux_template = init_mux_template;
    byte[32] a_template = init_a_template;
    byte[32] b_template = init_b_template;

    // Mutable shared application state
    int value = init_value;

    // Worker B is the other routed branch. It applies a net value change from
    // gain minus fee, then hands control back to Mux.
    entrypoint function apply(int gain, int fee, byte[] mux_prefix, byte[] mux_suffix) {
        // Pre-conditions: verify covenant boundaries (1 -> 1)
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        // Worker B logic:
        //
        // 1. Verify the net update is positive
        require(gain > fee);

        // 2. Rebuild the next state with the net value change
        State state = {
            mux_template: mux_template,
            a_template: a_template,
            b_template: b_template,
            value: value + gain - fee
        };

        // 3. Return to Mux
        validateOutputStateWithTemplate(output_idx, state, mux_prefix, mux_suffix, mux_template);
    }
}
